# The Forever Project.
# Generated guide JSON is rebuilt by `npm run data`; zone map images are committed (see docs/MAP_IMAGES.md).
# Anchored as /data/ so a bare "data/" does not hide web/src/data/ (source).

# Pipeline outputs and published site data (regenerated; never commit)
/data/
web/public/data/

# Local pipeline overrides
config.local.json

# Text dumps never belong in the repo. Markdown docs are not matched.
*.txt

# Node
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# package-lock.json is committed (app lockfile).

# Vite / TypeScript
dist/
.vite/
*.local
*.tsbuildinfo

# Vitest
coverage/
.vitest-cache/

# Secrets. Commit a template with: git add -f .env.example
.env
.env.*
!.env.example

# Python (pipeline/)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors and AI tools: per-person setup (MCP servers, keys, rules, launch configs). Never shared.
.idea/
.vscode/
.cursor/
.windsurf/
.zed/
*.suo
*.user
.mcp.json

# Test and tool output
test-results/
playwright-report/
blob-report/
*.log

# Confidential / private (plans, agent briefs, local launch config)
plan.md
.scratch/
.superpowers/
.claude/*
!.claude/skills/
.claude/skills/**/*.local.json

# Obvious secrets
*.pem
*.key
credentials.json
secrets.*
.env.local

research/external/

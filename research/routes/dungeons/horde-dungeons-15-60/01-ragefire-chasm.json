   "tips": [
    {
     "kind": "general",
     "text": "Pull troggs in pairs and let casters come to you around corners; Taragaman and Jergosh are the only real threats.",
     "roles": [
      "tank"
     ],
     "dungeons": true,
     "sources": [
      {
       "url": "https://www.wowhead.com/classic/zone=2437",
       "label": "Wowhead Classic: Ragefire Chasm"
      }
     ],
     "verified": false
    },
    {
     "kind": "general",
     "text": "Mana is the limit at this level; drink after every second pack and stand where the tank can line-of-sight casters to you.",
     "roles": [
      "healer"
     ],
     "dungeons": true,
     "sources": [
      {
       "url": "https://www.wowhead.com/classic/zone=2437",
       "label": "Wowhead Classic: Ragefire Chasm"
      }
     ],
     "verified": false
    },
    {
     "kind": "general",
     "text": "Kill shaman first; the whole run is a straight line, so skip side caves unless you still need satchel or quest drops.",
     "roles": [
      "dps"
     ],
     "dungeons": true,
     "sources": [
      {
       "url": "https://www.wowhead.com/classic/zone=2437",
       "label": "Wowhead Classic: Ragefire Chasm"
      }
     ],
     "verified": false
    },
    {
     "kind": "general",
     "text": "Run Ragefire Chasm once from the Cleft of Shadow. Do not reset for more troggs or for The Power to Destroy.",
     "routes": [
      "balanced"
     ],
     "sources": [
      {
       "url": "https://github.com/Questie/QuestieDB/blob/master/data/Forever/foreverQuestDB.lua",
       "label": "Questie 5728 pre 5727, zone 2437"
      }
     ],
     "verified": false
    },
    {
     "kind": "general",
     "text": "At most five dungeon entries/resets per hour. Kill XP inside dungeons is increased by 50%. If any party member would get no XP because the mobs are trivial to them, nobody in the party gets XP.",
     "routes": [
      "balanced",
      "speedrun"
     ],
     "sources": [
      {
       "url": "https://news.blizzard.com/en-us/article/24315281/wow-forever-hotfixes-november-20-2026",

  {
   "id": "zephras-isle:103",
   "tags": {},
   "text": [
    {
     "segments": [
      {
       "t": "Town stop 1, Valanaar east side (level 9). Walk in from the west and take everything on the way to the east end:"
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Nyalah Brightfire (cooking trainer): accept Crab Season. The crawlers are at Windsong Lake, much later."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Donaal Downbreeze (innkeeper): set your hearthstone here."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Alvarion Windfield: accept Blood Tithe. You don't need to listen to his story; it's optional."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Lotheluum Starbreeze: accept Unnerving Silence. It's a breadcrumb to Elegael Thornpaw in the north, so just carry it."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Valennia Stormfist: turn in To Valanaar (pick any of the three rewards), accept The Grand Skyseer."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Talaanis Shadowsong (next to her): turn in Deliver the Signet. Then back to Valennia: accept Bugged, which needs the Signet handed in first."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Ealaane Nimbuswalker: accept Aid For The Refugees and The Fate of a Loved One. Both are done in the Ruins of Ban'aethal up north."
      }
     ]
    }
   ],

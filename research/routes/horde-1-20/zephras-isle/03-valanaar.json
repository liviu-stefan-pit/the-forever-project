  {
   "id": "zephras-isle:110",
   "tags": {},
   "text": [
    {
     "segments": [
      {
       "t": "Town stop 1, west side:"
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Ayessa Dawnsinger: turn in The Grand Skyseer, accept A Grand Adventure and stand still while she talks (about 80 seconds), turn it in, accept The Broken Construct."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Endaria Mistgaze (next to the Shaman trainer): accept Unwelcome Spirits. The Wind Hollows are in the Ruins of Ban'aethal up north."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Riaani Nightwind: turn in The Broken Construct, accept the next The Broken Construct and listen to him. The three parts are at the Windfield bandit camp, the Shriekling Den and Windsong Lake, all on the route."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Keep Bugged in your bags: Valennia is at the east end, so hand it in at town stop 2."
      }
     ]
    }
   ],

   "text": [
    {
     "segments": [
      {
       "t": "Town stop 3, Valanaar (level 12). Other classes come straight here from Windsong Lake."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Endaria Mistgaze: turn in Unwelcome Spirits."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Riaani Nightwind: turn in The Broken Construct, accept the last The Broken Construct (it's done on accept)."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Nyalah Brightfire: turn in Crab Season (Recipe: Pincer Bites)."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Ayessa Dawnsinger: turn in The Broken Construct, accept A Firm Response."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Lotheluum Starbreeze: turn in The Fate of the Den."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Ealaane Nimbuswalker: turn in Aid For The Refugees and The Fate of a Loved One."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Not a Shaman: train your level 12 spells at your class trainer once these hand-ins are done."
      }
     ]
    }

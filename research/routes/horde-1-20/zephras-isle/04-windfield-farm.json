   "text": [
    {
     "segments": [
      {
       "t": "Windfield Orchard (south-west of Valanaar). Aamelia Windfield at her house: finish Blood Tithe by finding her, turn it in, accept Make Yourself Useful, Ornery Ornery Galestriders and Flutterfly Dust."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Aamelia moves between her house (46.7, 81.9) and the edge of the field (47.5, 78.5). Look for her in both spots on later hand-ins."
      }
     ]
    }
   ],

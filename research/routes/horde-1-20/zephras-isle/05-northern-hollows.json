   "tags": {},
   "text": [
    {
     "segments": [
      {
       "t": "Al'Aketh camp east of Elegael (63-65.5, 36.5-39): kill Al'Aketh Stormchasers and Footsoldiers. 10 Bloody Heirlooms drop from almost every kill (10 from 11 looted, 91%). The 5 Al'Aketh Cultist's Ears are slower: 5 from 13 looted (38%), so expect about 14 kills for both."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Pick up 8 Lady's Tear Moss from the ground as you go. It grows between Elegael and the camp (58.8-62.2, 36.4-40.4), 8 pickups over about 12 minutes of other work."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Commander Haalien stands in the camp (65.2, 36.4). You need his head later for The Ties That Bind, so leave him for now or kill him again then."
      }
     ]
    }
   ],

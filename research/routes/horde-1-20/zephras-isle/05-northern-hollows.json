  {
   "id": "zephras-isle:leave-zephras-speedrun",
   "tags": {},
   "text": [
    {
     "segments": [
      {
       "t": "Speedrun: leave Zephras Isle here, at about level 10.5 (the playtest was 10.8 at this point). The rest of the island pays less per minute than the mainland."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Take the skycutter from the dock in Valanaar to Mulgore. No quest is needed to board it."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "In Mulgore, grind to 12 (next step), then run east to the Crossroads and continue with The Barrens 12-20 (Horde). Skip its first step: Conscript of the Horde starts in Razor Hill, which you never visited."
      }
     ]
    }
   ],
   "actions": [
    {
     "type": "goto",
     "at": {
      "mapId": 2521,
      "x": 62.0,
      "y": 75.0,
      "zone": "Zephras Isle",
      "exact": false
     }
    }
   ],
   "conditions": [],
   "routes": [
    "speedrun"
   ],
   "sources": [

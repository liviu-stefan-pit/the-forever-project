   "verified": true,
   "tips": [
    {
     "kind": "general",
     "text": "The Great Outdoors does not need Cooking. In the playtest it was done and handed in before Cooking was learned.",
     "sources": [
      {
       "url": "https://github.com/liviu-stefan-pit/the-forever-project/blob/main/research/playtests/zephras-isle-plan.md",
       "label": "Playtest 2026-11-26 (Shaman 6-9, AdventureLog)"
      }
     ],
     "verified": true
    },
    {
     "kind": "general",
     "text": "Camping 101 quests give 270 XP each. Cooking is instant once you learn it at Zerril, who is on this stop anyway. First Aid finishes at skill 20, which comes on its own if you bandage up between pulls. Fishing to 20 took about 7 minutes at Windsong Lake, so it's only worth it on Balanced.",
     "sources": [
      {
       "url": "https://github.com/liviu-stefan-pit/the-forever-project/blob/main/research/playtests/zephras-isle-plan.md",
       "label": "Playtest 2026-11-26 (Shaman 6-9, AdventureLog)"
      }
     ],
     "verified": true
    },
    {
     "kind": "general",
     "text": "Campfire buffs (Fish Bowl +8% stats at Fishing 20, and other players' camp items) are optional. The route works with none of them. A Camp Tent only fills rested xp up to 5% of a level and does nothing if you already have more.",
     "sources": [
      {
       "url": "https://github.com/Questie/QuestieDB",
       "label": "QuestieDB quests.json id 96101"
      },
      {
       "url": "https://www.wowhead.com/classic/quest=96101",
       "label": "Wowhead quest 96101"
      }
     ],
     "verified": false
    },
    {
     "kind": "general",
     "text": "Cooking a basic meal gives Well Fed: +5% kill xp for 15 minutes, if you keep food on hand. The route does not require it.",
     "sources": [
      {
       "url": "https://github.com/Questie/QuestieDB",
       "label": "QuestieDB quests.json id 96101"
      },
      {
       "url": "https://www.wowhead.com/classic/quest=96101",
       "label": "Wowhead quest 96101"
      }
     ],
     "verified": false
    }
   ]

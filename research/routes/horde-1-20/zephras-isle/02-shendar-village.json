 "title": "Shen'dar Village",
 "steps": [
  {
   "id": "zephras-isle:056",
   "tags": {},
   "text": [
    {
     "segments": [
      {
       "t": "Town stop 1, Shen'dar Village (level 6). Take everything here before going out:"
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Raan Wildwind (west edge, by the tent): turn in The Adventurer, accept The Great Outdoors. Sit at his campfire until you get Boosted Rest (about a minute), then turn it in. You don't need Cooking for it."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Raan Wildwind: accept Camping 101: Cooking and Camping 101: First Aid (270 XP each), plus the Camping 101 for any primary profession you'll learn here."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Constable Aonda: turn in The Next Step, accept Welcome to Shen'dar Village."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Illaya Amberwind: talk to her for Welcome, accept The Windshapers, listen to her, turn it in, accept Meddlesome Mages."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Coriella Calmbreeze (innkeeper): talk to her for Welcome."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Constable Aonda: turn in Welcome to Shen'dar Village, accept The Criminal Element."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Teeri Wellwind: accept Pilfered Windstones and Hippogryph Harassment."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Taleen Shimmerthread: accept A Little Beauty."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Indari Sunseam: accept The Problem With Prideclaws."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Zerril Softbreeze: learn Cooking, turn in Camping 101: Cooking, accept Restocking the Larders."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Bounty board: accept WANTED: Vulgara the Insatiable."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Naleeia Tattermend: learn First Aid. Camping 101: First Aid finishes at skill 20, so make Linen Bandages as you get cloth."
      }
     ]
    }
   ],

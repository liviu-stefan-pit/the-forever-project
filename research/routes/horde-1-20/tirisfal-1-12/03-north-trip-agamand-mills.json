   "tags": {},
   "text": [
    {
     "segments": [
      {
       "t": "North of Brill, from the graveyard up to Garren's Haunt:"
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Rot Hide Graverobbers (53-58, 39-46) and Rot Hide Mongrels (56-61, 31-38): kill the ones Graverobbers asks for and loot 8 Embalming Ichor (the Rot Hide Gnolls drop it too)."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Pick 10 Doom Weed. It grows between the gnoll camps (55-59, 34-43)."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Greater Duskbats east of the gnolls (60-65, 40-46): 5 Duskbat Pelts."
      }
     ]
    }
   ],

   "text": [
    {
     "segments": [
      {
       "t": "Town stop 3, Brill (level ~9.5). Hand in everything from the north:"
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Magistrate Sevren: turn in Graverobbers, accept Forsaken Duties."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Junior Apothecary Holland: turn in Doom Weed, accept Tomb Weed."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Deathguard Dillinger: turn in The Mills Overrun."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Executor Zygand: turn in Wanted: Maggot Eye."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Coleman Farthing: turn in The Haunted Mills and Deaths in the Family, accept Speak with Sevren. Yvette Farthing (upstairs): turn in A Letter Undelivered."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Magistrate Sevren: turn in Speak with Sevren."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Gretchen Dedmar: turn in The Chill of Death."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Apothecary Johaan: turn in A New Plague, accept the next one (spider venom, east trip)."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Nurse Neela: turn in Camping 101: First Aid if your First Aid is 20."
      }
     ]
    }
   ],

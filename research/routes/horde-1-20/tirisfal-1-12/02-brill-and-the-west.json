  {
   "id": "tirisfal-1-12:041",
   "tags": {},
   "text": [
    {
     "segments": [
      {
       "t": "Road east to Brill. Three quest givers stand on it:"
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Calvin Montague (just north of the road, 38.2, 56.8): accept A Rogue's Deal. It's a letter for the Brill innkeeper."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Deathguard Simmer (on the road, 40.9, 54.2): accept Fields of Grief. The pumpkins are for the west trip, so just carry it."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Gordo (on the road, 43.1, 54.7): accept Gordo's Task. Pick 3 Gloom Weed: it grows beside the road all the way to Brill."
      }
     ]
    }
   ],

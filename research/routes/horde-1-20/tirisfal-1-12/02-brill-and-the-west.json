   "tags": {},
   "text": [
    {
     "segments": [
      {
       "t": "Town stop 2, Brill (level ~7.9). Hand in, then take the north quests:"
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Eleanor Shackleton (on the way in): turn in Sticks and Bones."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Executor Zygand: turn in At War With The Scarlet Crusade, Discipline and Patience, accept the next At War With The Scarlet Crusade."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Deathguard Burgess: accept Proof of Demise. Keep every Scarlet Insignia Ring from now on."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Apothecary Johaan: turn in Fields of Grief and A New Plague, accept the next A New Plague. Take the Laced Pumpkin down to the Captured Scarlet Zealot in the inn's cellar."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Shari Stilwell: turn in Seeking Refuge."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Deathguard Dillinger: turn in A Putrid Task, accept The Mills Overrun."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Coleman Farthing (inn): accept The Haunted Mills and Deaths in the Family (both need level 7)."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Gretchen Dedmar (inn): accept The Chill of Death. Buy 1 Coarse Thread from the trade goods vendor."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Wanted! poster outside the town hall: accept Wanted: Maggot Eye."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Train your level 8 spells. ⚡ You arrive about 1-2 mobs short of 8: kill one more Scarlet or Rotting Dead on the walk in so you only train once."
      }
     ]
    }
   ],

  {
   "id": "tirisfal-1-12:044",
   "tags": {},
   "text": [
    {
     "segments": [
      {
       "t": "Town stop 1, Brill (level ~6). Take everything here before going out:"
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Innkeeper Renee: set your hearthstone, turn in A Rogue's Deal."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Executor Zygand: turn in Vital Intelligence, accept At War With The Scarlet Crusade, Discipline and Patience."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Discipline: use the item on 5 Deathguards. They stand all around Brill."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Deathguard Dillinger: accept A Putrid Task. Patience: take his report while you're there."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Deathguard Bartholomew (next to him): accept Sticks and Bones."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Apothecary Johaan: accept A New Plague (needs level 6)."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Magistrate Sevren (town hall): accept Graverobbers."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Junior Apothecary Holland (graveyard, north-west edge): turn in Gordo's Task, accept Doom Weed."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "William Pickman: learn Cooking, turn in Camping 101: Cooking. Nurse Neela: learn First Aid."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Train your level 6 spells."
      }
     ]
    }
   ],

   "text": [
    {
     "segments": [
      {
       "t": "South of the village (around Kaga's camp): kill Prairie Wolves for 6 Prairie Wolf Paws and Plainstriders for 4 Plainstrider Talons."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Keep the Prairie Wolf Heart and the Plainstrider Scale for Mazzranache, and the Tender Strider Meat (Adult Plainstriders) for Kyle."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Pick up 2 Ambercorn from the ground on the way. The acorns lie all over the plains around the village."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Palemane camp south-east of Kaga: kill 10 Palemane Tanners, 8 Palemane Skinners and 5 Palemane Poachers."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Winterhoof Water Well (east of the camp): loot 2 Well Stones around the well."
      }
     ]
    }

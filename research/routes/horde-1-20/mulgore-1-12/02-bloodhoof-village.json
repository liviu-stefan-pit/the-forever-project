   "text": [
    {
     "segments": [
      {
       "t": "Town stop 1, Bloodhoof Village (level ~5.8). Take everything here before going out:"
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Baine Bloodhoof: turn in Rites of the Earthmother, accept Sharing the Land and Rite of Vision."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Innkeeper Kauth: turn in A Task Unfinished, set your hearthstone."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Zarlman Two-Moons: turn in Rite of Vision, accept the next Rite of Vision."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Mull Thunderhorn: accept Poison Water."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Ruul Eagletalon: accept Dangers of the Windfury."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Harken Windtotem: accept Swoop Hunting."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Maur Raincaller: accept Mazzranache."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Yaw Sharpmane: accept Chakuyak."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Ahab Wheathoof (north edge): accept Kyle's Gone Missing!"
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Brave Wildrunner (next to Baine): accept Longwalker Malah."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Pyall Silentstride: learn Cooking, turn in Camping 101: Cooking."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Vira Younghoof: learn First Aid."
      }
     ]
    }
   ],

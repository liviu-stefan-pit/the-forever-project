   "text": [
    {
     "segments": [
      {
       "t": "Zarlman Two-Moons: drink the Water of the Seers at the fire in front of him. Follow the vision north-west to Seer Wiserunner."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Plains on the way (around the Thunderhorn well): kill Prairie Stalkers for 6 Stalker Claws and Flatland Cougars for 6 Cougar Claws."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Same field: Swoops for 8 Trophy Swoop Quills and a Swoop Gizzard, Flatland Cougars for the Flatland Cougar Femur (Mazzranache)."
      }
     ]
    },
    {
     "segments": [
      {
       "t": "Seer Wiserunner: turn in Rite of Vision, accept Rite of Wisdom (that one is for the north trip at the end)."
      }
     ]
    }
   ],

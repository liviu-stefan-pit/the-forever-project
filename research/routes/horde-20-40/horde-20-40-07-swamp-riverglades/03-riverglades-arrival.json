   "tags": {},
   "text": [
    {
     "segments": [
      {
       "t": "When you reach the mid-30s, head to Riverglades, the WoW Forever zone aimed at this bracket. The fastest Undercity → Rog'mar flight is Undercity → Kargath → Rog'mar once you have Gorrik. Powderfuse Port has no usable flight master; the boat from Steamwheedle Port is the way in."
      }
     ]
    }
   ],

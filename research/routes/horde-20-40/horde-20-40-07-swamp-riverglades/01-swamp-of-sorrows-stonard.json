   "text": [
    {
     "segments": [
      {
       "t": "From Grom'gol or Stonard, work the Swamp of Sorrows quests around Stonard as you close in on level 40."
      },
      {
       "t": "The level 40 mount is 100g. Screeching Canyon harpies in Thousand Needles (about 27, 54, levels 28-31) are a gold farm if the camp is uncontested, not a required grind."
      }
     ]
    }
   ],
